{
  "name": "change-of-pace",
  "type": "module",
  "version": "9.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && npm run ogp-sort",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "ogp-sort": "node generated/ogp/ogp-sort.mjs",
    "lint-check": "npm run lint:eslint && npm run lint:stylelint && npm run check:prettier",
    "lint:eslint": "eslint \"./src/**/*.{js,jsx,ts,tsx,astro}\"",
    "lint:stylelint": "stylelint \"./src/**/*.scss\"",
    "lint:textlint:full": "textlint --cache \"src/content/**/*.{md,mdx}\" -f pretty-error",
    "check:prettier": "prettier --check \"./src/**/*.{js,jsx,ts,tsx,astro,html,json,yml}\"",
    "fix": "npm run fix:eslint && npm run fix:stylelint && npm run fix:prettier",
    "fix:eslint": "npm run lint:eslint -- --fix",
    "fix:stylelint": "npm run lint:stylelint -- --fix",
    "fix:textlint:full": "textlint --cache \"src/content/**/*.{md,mdx}\" --fix",
    "fix:prettier": "npm run check:prettier -- --write",
    "prepare": "lefthook install || echo 'Can not set git hooks'"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/system-uicons": "^1.2.4",
    "@iconify-json/teenyicons": "^1.2.2",
    "@unocss/reset": "^66.7.5",
    "astro": "^7.1.3",
    "cheerio": "^1.2.0",
    "markdown-it": "^14.3.0",
    "neotraverse": "^1.0.1",
    "rehype-autolink-headings": "^7.1.0",
    "remark-breaks": "^4.0.0",
    "remark-flexible-code-titles": "^1.3.4",
    "sanitize-html": "^2.17.6",
    "sass": "^1.102.0",
    "wicg-inert": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.1",
    "@typescript-eslint/parser": "^8.65.0",
    "@unocss/astro": "^66.7.5",
    "@unocss/autocomplete": "^66.7.5",
    "@unocss/eslint-config": "^66.7.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.1",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "textlint": "^15.7.1",
    "textlint-filter-rule-comments": "^1.3.0",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unocss": "^66.7.5"
  }
}
